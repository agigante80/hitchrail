__pycache__/
*.py[cod]
.venv/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.import_linter_cache/
docs/design/hitchrail-session-manager.html
CLAUDE.local.md
.coverage

# Never published, with one exception. `.claude/` holds the project rules,
# agents and skills that name this machine and its projects, and a public
# repository is the wrong place for any of that. The exception is
# `.claude/CLAUDE.md`, the conventions file, which every clone and CI leg needs:
# `tests/test_docs_are_true.py` fails without it. The spelling matters: git
# cannot re-admit a file under an excluded DIRECTORY, so the pattern names the
# directory's contents rather than the directory.
.claude/*
!.claude/CLAUDE.md

# mutmut copies the tree here, one file per module holding every mutant of it.
# Regenerated by `uv run mutmut run`, never edited, and large.
mutants/
.mutmut-cache

# Private journal (local thinking notes, never committed)
.private-journal/
